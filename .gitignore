*.swo

# Large Video & Image Datasets (keep directories via .gitkeep)
data/raw_videos/*
!data/raw_videos/.gitkeep
data/extracted_frames/*
!data/extracted_frames/.gitkeep
data/calibration_images/*
!data/calibration_images/.gitkeep
data/modelnet40/
data/objectron_test_subset/
data/uploads/
*.zip
!scripts/colab_mvs_input.zip
*.tar.gz
*.log

# Third-party Objectron media (keep manifests and attribution, not downloaded assets)
data/objectron_subset*/media/

# Pipeline Outputs
outputs/sfm/*
!outputs/sfm/.gitkeep
outputs/detections_2d/*
!outputs/detections_2d/.gitkeep
outputs/objects_3d/*
!outputs/objects_3d/.gitkeep
outputs/visualizations/*
!outputs/visualizations/.gitkeep
outputs/runs/
outputs/uploads/

# Deep Learning Model Weights (Large binary files)
models/weights/*
!models/weights/.gitkeep
!models/weights/pointnet_modelnet40.pth

# COLMAP intermediate databases
*.db
*.db-shm
*.db-wal

# Intermediate depth numpy caches
outputs/objectron/*/depth_cache/*.npy
outputs/dense_depth/*.npy
outputs/deployment_live_validation/colmap/
outputs/deployment_live_validation/keyframes/
outputs/deployment_live_validation/dense_fusion/

